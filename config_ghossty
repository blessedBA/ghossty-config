# ---------- shell ----------
command = /opt/homebrew/bin/fish
shell-integration = fish
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# ---------- look ----------
font-size = 14
window-width = 140
window-height = 38

window-padding-x = 6
window-padding-y = 6

background = 0b0f14
foreground = d6deeb
cursor-style = block

window-theme = dark
macos-option-as-alt = true

background-opacity = 0.92
background-opacity-cells = true
background-blur = 20

confirm-close-surface = true

# ---------- workflow ----------
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+w=close_tab
keybind = cmd+shift+q=close_window
keybind = cmd+shift+t=undo

keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:down
keybind = cmd+alt+k=goto_split:up
keybind = cmd+alt+l=goto_split:right

keybind = cmd+ctrl+h=resize_split:left,20
keybind = cmd+ctrl+j=resize_split:down,20
keybind = cmd+ctrl+k=resize_split:up,20
keybind = cmd+ctrl+l=resize_split:right,20

keybind = cmd+shift+z=toggle_split_zoom
keybind = cmd+shift+e=equalize_splits

keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab

keybind = cmd+shift+p=toggle_command_palette
keybind = global:cmd+backquote=toggle_quick_terminal

keybind = cmd+shift+r=reload_config
keybind = cmd+shift+o=open_config
